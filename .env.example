# Environment variables for Workflow Runtime Core
# Copy to .env and fill in values. .env is gitignored.

# The registry DSN. There is deliberately no local-file fallback: run state must
# be durable and shared, so an unset value is a misconfiguration, not a cue to
# degrade. Under entra auth (below) this carries a PRINCIPAL NAME and NO password.
STROMY_PG_DSN=postgresql://user:password@localhost:5432/stromy_runtime

# --- Passwordless PostgreSQL via Microsoft Entra (ORG-PLAN-226) --------------
# All optional. Every one of them unset is the pre-0.8.0 behaviour exactly, which
# is what keeps this release additive for existing consumers.

# password (default) | entra. `entra` needs the `azure-postgres` extra.
WRC_PG_AUTH=password

# managed-identity | azure-cli. Required when WRC_PG_AUTH=entra, and it has NO
# default on purpose: DefaultAzureCredential succeeds with whichever source
# answers first, which would make the database identity a property of the
# ambient environment rather than of the deployment.
WRC_PG_CREDENTIAL=

# Pins a specific user-assigned identity when a workload carries more than one.
# With two attached, an unqualified managed-identity request resolves to the
# SYSTEM-assigned principal — which may hold nothing, failing as a 403 on first
# query long after deployment reported success.
AZURE_CLIENT_ID=

# Role a migration command assumes (SET ROLE) before touching anything, so
# objects are owned by it rather than by the login that ran the migration.
# Unset means this deployment does not separate ownership.
WRC_PG_OWNER_ROLE=

# Role whose grants each migration chain reconciles: DML on its operational
# tables, SELECT on its migration ledgers.
WRC_PG_APPLICATION_ROLE=

# run (default) | verify. `verify` makes the runtime ASSERT the LangGraph
# checkpoint store is present and current instead of calling setup(), which is
# DDL. A DML-only runtime sets this; `wrc checkpoint-setup` does the migrating.
WRC_CHECKPOINT_SETUP=run
